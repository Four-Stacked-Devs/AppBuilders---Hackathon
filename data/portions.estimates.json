[
  {
    "match": "^Rice.*(boiled|fried|gruel)|^Rice-corn.*boiled|^Corn.*boiled",
    "groups": "AB",
    "portions": { "cup": 160, "bowl": 200, "plate": 250, "serving": 160 },
    "default": "cup",
    "note": "typical cup of cooked rice, about 160 g"
  },
  {
    "match": "pan de sal|pandesal",
    "portions": { "piece": 30, "serving": 60 },
    "default": "piece",
    "note": "one pandesal roll, about 30 g"
  },
  {
    "match": "^Bread|^Biscuit|^Cracker|^Cookie",
    "groups": "A",
    "portions": { "piece": 30, "serving": 60 },
    "default": "piece",
    "note": "one slice or piece, about 30 g"
  },
  {
    "match": "^Banana",
    "portions": { "piece": 90, "serving": 90 },
    "default": "piece",
    "note": "one medium banana, about 90 g edible"
  },
  {
    "match": "^Egg, chicken",
